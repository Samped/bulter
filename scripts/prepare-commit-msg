#!/usr/bin/env bash
# Strip Cursor attribution before commit-msg runs.
# Install: ln -sf ../../scripts/prepare-commit-msg .git/hooks/prepare-commit-msg
msg_file="${1:?}"
tmp="$(mktemp)"
grep -viE '^(Co-authored-by|Made-with):.*cursor' "$msg_file" \
  | grep -viE 'cursoragent@cursor\.com' \
  > "$tmp"
mv "$tmp" "$msg_file"
